From: xob0t <32616886+xob0t@users.noreply.github.com>
Date: Thu, 19 Nov 2026 08:34:03 +0300
Subject: [PATCH 26/27] A class's static data pointer merged from several paths
 is that class's statics

When paths that each read a class's static data pointer are merged (tail merging), the field reads after the
merge went through a variable holding the pointer: "__statics()" gaps. A merge whose every way in is the same
class's statics now means those statics. On a commercial Unity 6000.0.60f1 game: Assembly-CSharp 2,743 ->
2,765 complete bodies, __statics() sites 85 -> 10, no complete body lost or changed.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/Rewind.Analysis/Recover/HirBuilder.cs | 31 ++++++++++++++++++++++-
 1 file changed, 30 insertions(+), 1 deletion(-)

diff --git a/src/Rewind.Analysis/Recover/HirBuilder.cs b/src/Rewind.Analysis/Recover/HirBuilder.cs
index 22eb11c..2fc8693 100644
--- a/src/Rewind.Analysis/Recover/HirBuilder.cs
+++ b/src/Rewind.Analysis/Recover/HirBuilder.cs
@@ -1,4 +1,4 @@
-// Modified for t2d-no-fate-vita (2026): virtual calls through merged class pointers, gaps always marked, small structs as numbers, floating-point negation, bits read as float/double, merged struct returns, long stack slots that held a reference and a number, struct addresses typed as their target. See NOTICE.md in that project's tools/rewind/patches.
+// Modified for t2d-no-fate-vita (2026): virtual calls through merged class pointers, gaps always marked, small structs as numbers, floating-point negation, bits read as float/double, merged struct returns, long stack slots that held a reference and a number, struct addresses typed as their target, merged statics pointers. See NOTICE.md in that project's tools/rewind/patches.
 using Rewind.Analysis.Abi;
 using Rewind.Analysis.Hir;
 using Rewind.Analysis.Ir;
@@ -1205,6 +1205,13 @@ public sealed partial class HirBuilder
                 _sem[phi] = boundSem;
                 continue;
             }
+            // One class's static data whichever way in: the compiler merged the paths after each read the
+            // pointer (tail merging), and the field reads after the merge are of that class's statics.
+            if (!NoMergedStatics && MergedStatics(phi) is { } statics)
+            {
+                _sem[phi] = statics;
+                continue;
+            }
             // The address of one stack object or another, by the way in: a reference variable.
             if (MergedPointee(phi) is { } pointee)
             {
@@ -1239,6 +1246,28 @@ public sealed partial class HirBuilder
         }
     }
 
+    private static readonly bool NoMergedStatics = Environment.GetEnvironmentVariable("REWIND_NO_MERGED_STATICS") != null;
+
+    /// <summary>The static data of one class, when every way into the merge gives that pointer; null otherwise.</summary>
+    private SStatics? MergedStatics(Node phi)
+    {
+        SStatics? found = null;
+        foreach (Node input in phi.In)
+        {
+            if (ReferenceEquals(input, phi)) continue;
+            // (Only a read of a class's static data pointer is looked at here, before the blocks are built: the
+            // class, a constant of the image, and the offset of its static data.)
+            Sem? s = input.Op == Op.Phi ? _sem.GetValueOrDefault(input)
+                : input.Op == Op.Load && input.In[0] is { Op: Op.Add } address && address.In[1].IsConst &&
+                  address.In[1].Imm == _p.Klass.StaticFields && address.In[0].Op is Op.SlotValue or Op.Load &&
+                  Peek(address.In[0]) is SKlass klass ? new SStatics(klass.Type) : null;
+            if (s is not SStatics statics) return null;
+            if (found == null) found = statics;
+            else if (found.Type.Key != statics.Type.Key) return null;
+        }
+        return found;
+    }
+
     /// <summary>Assignments that give a successor's merged values their value along the edge from this block.</summary>
     private List<HAssign> PhiCopies(Block from, Block to)
     {
