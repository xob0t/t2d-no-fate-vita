From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: xob0t <32616886+xob0t@users.noreply.github.com>
Date: Thu, 19 Nov 2026 05:15:31 +0300
Subject: [PATCH 19/22] Bits read as a float or double without BitConverter

Where the game's class library has no BitConverter call for a reinterpretation (a stripped
mscorlib with DoubleToInt64Bits but no Int64BitsToDouble, or no Int32BitsToSingle), the
value was left opaque ("bits reinterpreted as double (no BitConverter in this build)").
It is now the value's own memory read as the other type: HDeref of HAddressOf, typed as
the target (new HDeref.IsBitCast tells it apart), emitted as ldloca and ldobj and written
by the C# decompiler as "*(double*)(&bits)". The emitter gives the bits a local of their
own unless they are one already (or an argument): in C# the address of a local needs no
pinning. The same serves float to int and double to long, and the bits of a double read
as a double again are that double. REWIND_NO_BIT_CASTS turns this off.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/Rewind.Analysis/Hir/Hir.cs                | 17 ++++++++++++++
 .../Recover/HirBuilder.Parts.cs               | 22 +++++++++++++++++--
 src/Rewind.Analysis/Recover/HirBuilder.cs     |  3 ++-
 src/Rewind.Output/BodyEmitter.cs              | 12 ++++++++++
 4 files changed, 51 insertions(+), 3 deletions(-)

diff --git a/src/Rewind.Analysis/Hir/Hir.cs b/src/Rewind.Analysis/Hir/Hir.cs
index b0d5501..388a649 100644
--- a/src/Rewind.Analysis/Hir/Hir.cs
+++ b/src/Rewind.Analysis/Hir/Hir.cs
@@ -84,6 +84,23 @@ public sealed class HAddressOf(HExpr target) : HExpr
 public sealed class HDeref(HExpr pointer) : HExpr
 {
     public HExpr Pointer = pointer;
+
+    /// <summary>
+    /// Whether this reads a value's own memory as another number of the same size ("*(double*)&amp;bits", the
+    /// reinterpretation where the class library has no BitConverter call for it); <paramref name="original"/> is
+    /// the value.
+    /// </summary>
+    public bool IsBitCast(out HExpr original)
+    {
+        original = this;
+        if (Pointer is not HAddressOf { Target: { } target } || target.Type is not PrimitiveSig from || Type is not PrimitiveSig to || ReferenceEquals(from, to))
+            return false;
+        static bool Number(PrimitiveSig p) => p.Element is Il2CppTypeEnum.I4 or Il2CppTypeEnum.U4 or Il2CppTypeEnum.I8 or Il2CppTypeEnum.U8 or Il2CppTypeEnum.R4 or Il2CppTypeEnum.R8;
+        static bool Wide(PrimitiveSig p) => p.Element is Il2CppTypeEnum.I8 or Il2CppTypeEnum.U8 or Il2CppTypeEnum.R8;
+        if (!Number(from) || !Number(to) || Wide(from) != Wide(to)) return false;
+        original = target;
+        return true;
+    }
 }
 
 public sealed class HUnary(HUnaryOp op, HExpr operand) : HExpr
diff --git a/src/Rewind.Analysis/Recover/HirBuilder.Parts.cs b/src/Rewind.Analysis/Recover/HirBuilder.Parts.cs
index c30e3a5..81aa6f3 100644
--- a/src/Rewind.Analysis/Recover/HirBuilder.Parts.cs
+++ b/src/Rewind.Analysis/Recover/HirBuilder.Parts.cs
@@ -147,9 +147,23 @@ public sealed partial class HirBuilder
         return null;
     }
 
+    private static readonly bool NoBitCasts = Environment.GetEnvironmentVariable("REWIND_NO_BIT_CASTS") != null;
+
+    /// <summary>
+    /// The value whose bits are those of <paramref name="value"/>, read as <paramref name="type"/> (a number of
+    /// the same size), where the class library has no call for it: the value's own memory read as the other
+    /// type, "*(double*)&amp;bits" (emitted as ldloca and ldobj). Null when that is off or the sizes differ.
+    /// </summary>
+    private HExpr? BitCast(HExpr value, TypeSig type)
+    {
+        if (NoBitCasts || value.Type is not PrimitiveSig || BitsOf(value.Type) is not (32 or 64) || BitsOf(value.Type) != BitsOf(type)) return null;
+        return new HDeref(new HAddressOf(value) { Type = _m.Sigs.Pointer(value.Type) }) { Type = type };
+    }
+
     /// <summary>Matches what SingleBits and SingleFromBits build (whichever way): the value whose bits are read as the other type.</summary>
     private static bool IsReinterpreted(HExpr e, string direct, string reader, out HExpr original)
     {
+        if (e is HDeref read && read.IsBitCast(out original)) return true;
         original = e;
         if (e is not HCall { This: null, Method: { DeclaringType: { Name: "BitConverter", Namespace: "System" } } method } call) return false;
         if (method.Name == direct && call.Arguments.Length == 1)
@@ -170,7 +184,7 @@ public sealed partial class HirBuilder
         if (ReferenceEquals(t, _float))
         {
             if (e is HConst { Value: float f }) return new HConst((long)(uint)BitConverter.SingleToInt32Bits(f), _long);
-            if (SingleBits(e) is { } asInt)
+            if ((SingleBits(e) ?? BitCast(e, _int)) is { } asInt)
                 return new HConv(HConvKind.U8, new HConv(HConvKind.U4, asInt) { Type = _uint }) { Type = _ulong };
             Problem("float reinterpreted as bits (no BitConverter in this build)");
             return Site(new HOpaque("float_bits", e) { Type = _long }, "float reinterpreted as bits (no BitConverter in this build)");
@@ -179,6 +193,7 @@ public sealed partial class HirBuilder
         {
             if (e is HConst { Value: double d }) return new HConst(BitConverter.DoubleToInt64Bits(d), _long);
             if (BitConverterMethod("DoubleToInt64Bits", _double) is { } toBits) return new HCall { Method = toBits, Arguments = [e], Type = _long };
+            if (BitCast(e, _long) is { } asLong) return asLong;
             Problem("double reinterpreted as bits (no BitConverter in this build)");
             return Site(new HOpaque("double_bits", e) { Type = _long }, "double reinterpreted as bits (no BitConverter in this build)");
         }
@@ -203,7 +218,7 @@ public sealed partial class HirBuilder
                 // The bits of a float, read as a float again, are that float.
                 HExpr narrow = Shortened(HConvKind.I4, _int, bits, 32);
                 if (IsReinterpreted(narrow, "SingleToInt32Bits", "ToInt32", out HExpr original) && ReferenceEquals(original.Type, _float)) return original;
-                if (SingleFromBits(narrow) is { } asFloat) return asFloat;
+                if ((SingleFromBits(narrow) ?? BitCast(narrow, _float)) is { } asFloat) return asFloat;
             }
             Problem("bits reinterpreted as float (no BitConverter in this build)");
             return Site(new HOpaque("bits_to_float", bits) { Type = _float }, "bits reinterpreted as float (no BitConverter in this build)");
@@ -212,6 +227,9 @@ public sealed partial class HirBuilder
         {
             if (bits is HConst { Value: int or long } c) return new HConst(BitConverter.Int64BitsToDouble(Convert.ToInt64(c.Value)), _double);
             if (BitConverterMethod("Int64BitsToDouble", _long) is { } fromBits) return new HCall { Method = fromBits, Arguments = [bits], Type = _double };
+            // The bits of a double, read as a double again, are that double.
+            if (!NoBitCasts && IsReinterpreted(bits, "DoubleToInt64Bits", "", out HExpr original) && ReferenceEquals(original.Type, _double)) return original;
+            if (BitCast(BitsOf(bits.Type) == 64 ? bits : new HConv(HConvKind.U8, bits) { Type = _ulong }, _double) is { } asDouble) return asDouble;
             Problem("bits reinterpreted as double (no BitConverter in this build)");
             return Site(new HOpaque("bits_to_double", bits) { Type = _double }, "bits reinterpreted as double (no BitConverter in this build)");
         }
diff --git a/src/Rewind.Analysis/Recover/HirBuilder.cs b/src/Rewind.Analysis/Recover/HirBuilder.cs
index 0cf85f9..414b7ba 100644
--- a/src/Rewind.Analysis/Recover/HirBuilder.cs
+++ b/src/Rewind.Analysis/Recover/HirBuilder.cs
@@ -1373,12 +1373,13 @@ public sealed partial class HirBuilder
         if (ReferenceEquals(e.Type, _float))
         {
             if (e is HConst { Value: float f }) return new HConst(BitConverter.SingleToInt32Bits(f), _int);
-            if (SingleBits(e) is { } asInt) return asInt;
+            if ((SingleBits(e) ?? BitCast(e, _int)) is { } asInt) return asInt;
             Problem("float reinterpreted as bits (no BitConverter in this build)");
             return new HOpaque("float_bits", e) { Type = _int };
         }
         if (e is HConst { Value: double d }) return new HConst(BitConverter.DoubleToInt64Bits(d), _long);
         if (BitConverterMethod("DoubleToInt64Bits", _double) is { } toLong) return new HCall { Method = toLong, Arguments = [e], Type = _long };
+        if (BitCast(e, _long) is { } asLong) return asLong;
         Problem("double reinterpreted as bits (no BitConverter in this build)");
         return new HOpaque("double_bits", e) { Type = _long };
     }
diff --git a/src/Rewind.Output/BodyEmitter.cs b/src/Rewind.Output/BodyEmitter.cs
index 9cb4960..c5cb31b 100644
--- a/src/Rewind.Output/BodyEmitter.cs
+++ b/src/Rewind.Output/BodyEmitter.cs
@@ -747,6 +747,18 @@ public sealed class BodyEmitter
                 case HAddressOf addr:
                     Address(addr.Target);
                     return;
+                case HDeref d when d.IsBitCast(out HExpr bits) && bits is not (HLocal or HArg):
+                {
+                    // Bits read as another type: from a local of their own (in C# the address of a local needs
+                    // no pinning, that of a field or an element would).
+                    var temp = new VariableDefinition(Ref(bits.Type));
+                    _body.Variables.Add(temp);
+                    Value(bits);
+                    _il.Emit(OpCodes.Stloc, temp);
+                    _il.Emit(OpCodes.Ldloca, temp);
+                    _il.Emit(OpCodes.Ldobj, Ref(d.Type));
+                    return;
+                }
                 case HDeref d:
                     Value(d.Pointer);
                     _il.Emit(OpCodes.Ldobj, Ref(d.Type));
