From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: xob0t <32616886+xob0t@users.noreply.github.com>
Date: Thu, 19 Nov 2026 06:07:58 +0300
Subject: [PATCH 16/22] Small structs computed with as numbers: rebuilt where
 the fields are known, marked where not

A struct of up to 8 bytes travels in a register, and code that takes it apart or puts
it together works on the register's bits. Where Rewind did not find which fields the
bits were, the struct was used as a number in IL ("ldarg.1; conv.i4" on a struct,
an int returned where a struct is), with no marker.

- Truncating a struct to a width that still holds all of it is the struct (the
  truncation only drops register bits above it), so the existing field rules see it:
  a setter that copies a 4-byte struct of a bool and a ushort reads back as one store
  of the struct again.
- A tail call whose result is returned where the method returns a struct that is one
  number (an explicit conversion operator pasted in) makes the struct from it.
- A struct where a number goes, through Coerce, is the struct's one number where it
  has one (ScalarOf).
- Anything else - a struct truncated, shifted or combined as bits with no field found,
  a number where a struct goes - is marked ("X used as a number", "could not rebuild X
  from a Y"); REWIND_NO_STRUCT_NUMBERS / REWIND_NO_WHOLE_STRUCT_TRUNCATION turn this off.

Unity 6000.0 Master x64 game, three game assemblies: 10 bodies rebuilt correctly, 1
newly marked (a Vector2 assembled from two floats' bits in a register).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../Recover/HirBuilder.Calls.cs               | 30 ++++++++++++++++++-
 .../Recover/HirBuilder.Values.cs              | 30 +++++++++++++++++++
 src/Rewind.Analysis/Recover/HirBuilder.cs     |  8 +++++
 3 files changed, 67 insertions(+), 1 deletion(-)

diff --git a/src/Rewind.Analysis/Recover/HirBuilder.Calls.cs b/src/Rewind.Analysis/Recover/HirBuilder.Calls.cs
index 5a38bc1..5ed521f 100644
--- a/src/Rewind.Analysis/Recover/HirBuilder.Calls.cs
+++ b/src/Rewind.Analysis/Recover/HirBuilder.Calls.cs
@@ -522,6 +522,27 @@ public sealed partial class HirBuilder
 
     // ---- results -----------------------------------------------------------------------------------------------
 
+    /// <summary>
+    /// A struct made from a value of another type: a struct that is one number, from that number ("new
+    /// HPipe(value)", its explicit conversion pasted in); anything else is marked.
+    /// </summary>
+    private HExpr StructOfValue(HExpr e, TypeSig structType, ulong addr)
+    {
+        TypeLayout layout = _p.Layouts.Of(structType);
+        if (layout.Known && layout.Fields.Length == 1 && layout.Fields[0] is { Offset: 0 } only && only.Size == layout.Size &&
+            only.Type is PrimitiveSig or { Definition.IsEnum: true } && !IsFloat(only.Type) && !IsFloat(e.Type) &&
+            (e.Type is PrimitiveSig or { Definition.IsEnum: true }) && !IsReference(e.Type) && BitsOf(e.Type) == BitsOf(only.Type))
+        {
+            HVar temp = _h.NewLocal(structType, "s");
+            temp.AddressTaken = true;
+            Emit(new HAssign(new HField { Object = new HLocal(temp) { Type = structType }, Field = only.Field, DeclaringType = structType, Type = only.Type }, e), addr);
+            return new HLocal(temp) { Type = structType };
+        }
+        string problem = $"could not rebuild {structType.DisplayName} from a {e.Type?.DisplayName ?? "value"}";
+        Problem(problem);
+        return Site(new HOpaque("struct_from_value", e) { Type = structType }, problem);
+    }
+
     private void FinishCall(Node call, HExpr expr, ReturnKind kind, TypeSig returnType, bool tail)
     {
         expr.Type ??= returnType;
@@ -532,7 +553,14 @@ public sealed partial class HirBuilder
                 Emit(new HEval(expr), call.Addr);
                 Emit(new HReturn(null), call.Addr);
             }
-            else Emit(new HReturn(expr), call.Addr);
+            else
+            {
+                // A struct returned where the call's result is something else (a conversion operator pasted in):
+                // the struct made from it.
+                if (_abi.ReturnType is { } returned && IsStructType(returned) && expr.Type is { } given && given.Key != returned.Key)
+                    expr = StructOfValue(expr, returned, call.Addr);
+                Emit(new HReturn(expr), call.Addr);
+            }
             return;
         }
 
diff --git a/src/Rewind.Analysis/Recover/HirBuilder.Values.cs b/src/Rewind.Analysis/Recover/HirBuilder.Values.cs
index 6f4723c..96b88de 100644
--- a/src/Rewind.Analysis/Recover/HirBuilder.Values.cs
+++ b/src/Rewind.Analysis/Recover/HirBuilder.Values.cs
@@ -366,6 +366,9 @@ public sealed partial class HirBuilder
             Problem(ReferenceArithmetic);
             return new SVal(Site(new HOpaque("reference_arithmetic", new HBinary(op, left, right) { Type = TypeForBits(n.Type) }) { Type = TypeForBits(n.Type) }, ReferenceArithmetic));
         }
+        // Nor is a struct whose fields were not found in the bits computed with.
+        if (IsStructType(left.Type)) left = StructAsNumber(left, TypeForBits(n.Type));
+        if (IsStructType(right.Type)) right = StructAsNumber(right, TypeForBits(n.Type));
         TypeSig type = isShift ? ResultIntType(n, n.In[0]) : ResultIntType(n, n.In[0], n.In[1]);
         if (n.Op is Op.DivU or Op.RemU or Op.ShrU && ReferenceEquals(type, _int)) type = _uint;
         if (n.Op is Op.DivU or Op.RemU or Op.ShrU && ReferenceEquals(type, _long)) type = _ulong;
@@ -397,6 +400,29 @@ public sealed partial class HirBuilder
         return new SVal(new HBinary(op, left, right) { Type = type });
     }
 
+    private static readonly bool NoWholeStructTruncation = Environment.GetEnvironmentVariable("REWIND_NO_WHOLE_STRUCT_TRUNCATION") != null;
+    private static readonly bool NoStructNumbers = Environment.GetEnvironmentVariable("REWIND_NO_STRUCT_NUMBERS") != null;
+
+    /// <summary>
+    /// A struct (not one number: see ScalarOf) whose bytes are computed with as a number. Which of its fields
+    /// those bits are was not found; IL has no such conversion, so it is marked.
+    /// </summary>
+    private HExpr StructAsNumber(HExpr e, TypeSig type)
+    {
+        if (NoStructNumbers) return e;
+        string problem = $"{e.Type!.DisplayName} used as a number";
+        Problem(problem);
+        return Site(new HOpaque("struct_bits", e) { Type = type }, problem);
+    }
+
+    private HExpr NumberAsStruct(HExpr e, TypeSig structType)
+    {
+        if (NoStructNumbers) return e;
+        string problem = $"could not rebuild {structType.DisplayName} from a {e.Type?.DisplayName ?? "number"}";
+        Problem(problem);
+        return Site(new HOpaque("struct_from_value", e) { Type = structType }, problem);
+    }
+
     private static readonly bool NoReferenceArithmetic = Environment.GetEnvironmentVariable("REWIND_NO_REFERENCE_ARITHMETIC") != null;
     private static readonly bool NoObjectHash = Environment.GetEnvironmentVariable("REWIND_NO_OBJECT_HASH") != null;
     internal const string ReferenceArithmetic = "a reference used as a number";
@@ -761,6 +787,8 @@ public sealed partial class HirBuilder
                 FieldSlot? slot = _p.Layouts.FieldAt(e.Type, 0);
                 if (slot is { } fs && fs.Offset == 0 && fs.Size * 8 == to)
                     return new SVal(new HField { Object = e, Field = fs.Field, DeclaringType = e.Type, Type = fs.Type });
+                // All of the struct fits: the truncation only drops the register bits above it.
+                if (!NoWholeStructTruncation && _p.Layouts.Of(e.Type) is { Known: true, Size: > 0 } whole && whole.Size * 8 <= to) return v;
                 // A struct that is one wider number: its low bytes are that number's ("(byte)delta" is (byte)delta.packed).
                 if (!NoNarrowScalars && ScalarOf(e, 64) is { } scalar && !ReferenceEquals(scalar, e))
                 {
@@ -768,6 +796,7 @@ public sealed partial class HirBuilder
                     known = BitsOf(e.Type);
                     if (known != 0 && known <= to) return new SVal(e);
                 }
+                if (IsStructType(e.Type)) return new SVal(StructAsNumber(e, TypeForBits(n.Type)));
             }
             if (known == 0 && inner.Type == VT.I64 && to == 32 && e.Type == null) return v; // untyped 32-bit value in a 64-bit register
             // The low bytes of a float or double are part of its bits, not the number converted.
@@ -782,6 +811,7 @@ public sealed partial class HirBuilder
     general:
         {
             HExpr e = IntValue(inner);
+            if (IsStructType(e.Type)) return new SVal(StructAsNumber(e, TypeForBits(n.Type)));
             HConvKind kind = to switch { 8 => HConvKind.U1, 16 => HConvKind.U2, 32 => HConvKind.I4, _ => HConvKind.I8 };
             TypeSig type = to switch { 8 => _byte, 16 => _ushort, 32 => _int, _ => _long };
             if (to is 8 or 16 or 32) return new SVal(Shortened(kind, type, PartOfCombined(e, 0, to) ?? e, to));
diff --git a/src/Rewind.Analysis/Recover/HirBuilder.cs b/src/Rewind.Analysis/Recover/HirBuilder.cs
index d48b57a..04b8034 100644
--- a/src/Rewind.Analysis/Recover/HirBuilder.cs
+++ b/src/Rewind.Analysis/Recover/HirBuilder.cs
@@ -1864,6 +1864,14 @@ public sealed partial class HirBuilder
             HExpr bits = FloatBits(e);
             return ReferenceEquals(target, _ulong) ? new HConv(HConvKind.U8, bits) { Type = _ulong } : bits;
         }
+        // A number where a struct goes, or a struct where a number goes, with nothing above that told which
+        // fields the bits are: no conversion IL has. (A struct that is one number is that number.)
+        if (IsStructType(target) && from is PrimitiveSig && !IsStructType(from)) return NumberAsStruct(e, target);
+        if (IsStructType(from) && target is PrimitiveSig)
+        {
+            HExpr scalar = ScalarOf(e, BitsOf(target));
+            return IsStructType(scalar.Type) ? StructAsNumber(e, target) : scalar;
+        }
         return e;
     }
 }
