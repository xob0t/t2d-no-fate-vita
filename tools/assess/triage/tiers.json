{
 "_doc": "triage.py's play order and replacements. Classes by short or full name; methods 'Class::name' (every overload) or 'Class::*'. Tiers run in order; a 'scene' takes its roots and maps from work/atlas-usage/scenes.json.",
 "scene_namespaces": [
  "com.bitmapbureau.terminator.apps",
  "com.bitmapbureau.terminator.scripts",
  "com.bitmapbureau.terminator.cutscenes"
 ],
 "scene_base_classes": [
  "App",
  "Script",
  "Cutscene",
  "CompoundScene"
 ],
 "cut_methods": [
  "Sprites::addFromJSON"
 ],
 "moot": {
  "SteamManager::*": "platform layer: stubbed (STEAM_BUILD false; ctors keep gaps but nothing makes one)",
  "EpicManager::*": "platform layer: stubbed",
  "GalaxyManager::*": "platform layer: stubbed",
  "PlayerPrefsX::*": "platform layer: stubbed (PlayerPrefs save mode unused)",
  "LeaderboardState::*": "platform layer: leaderboards only with STEAM_BUILD",
  "Platform::awardTrophy": "platform layer: stubbed",
  "Platform::mapTrophiesAndAward": "platform layer: stubbed",
  "UnityMain::dlc.*": "platform layer: stubbed",
  "Utils::setSteamDeck": "platform layer: stubbed",
  "Utils::systemLanguageSteam": "platform layer: forwarded to systemLanguageStandalone",
  "Sound::createSoundFromFile": "platform layer: Sounds.Clip loader",
  "PlayerPrefsX/*::*": "platform layer: stubbed",
  "BitmapData::unityDraw": "spritebatch R8: new body",
  "BitmapData::unityDrawClippedWidth": "spritebatch R8: new body",
  "BitmapData::CreateMultiMeshFrames": "spritebatch R7: new body",
  "AssetsPack::staticInit[5-9]": "atlas R1: table from Atlas",
  "BitmapData::loadTexturePacks": "atlas R4: Atlas.Preload"
 },
